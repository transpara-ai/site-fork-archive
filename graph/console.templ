package graph

import (
	"fmt"
	"strconv"

	"github.com/transpara-ai/site/assets"
	"github.com/transpara-ai/site/profile"
)

templ ConsolePage(data ConsolePageData, user ViewUser, p *profile.Profile) {
	<!DOCTYPE html>
	<html lang="en">
		@consoleHead(data.Title)
		if data.Workbench != nil {
			@civilizationWorkbenchShell(*data.Workbench)
		} else {
		<body class="bg-void text-warm-secondary min-h-screen flex flex-col">
			<main class="flex-1 max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10 w-full space-y-6">
				<header class="flex items-center justify-between gap-3">
					<div>
						<h1 class="text-2xl md:text-3xl font-display font-normal text-warm">Mission control</h1>
						<p class="text-sm text-warm-muted">transpara-ai civilization</p>
					</div>
				</header>
				<nav class="flex gap-1 border-b border-edge pb-1 text-sm overflow-x-auto">
					@consoleTab("workbench", "Workbench", "/console/workbench", data.Active, true)
					@consoleTab("mission-control", "Overview", "/console", data.Active, true)
					@consoleTab("health", "Health wall", "/console/health", data.Active, true)
					@consoleTab("kanban", "Kanban", "/console/kanban", data.Active, true)
					@consoleTab("intake", "Intake", "/console/intake", data.Active, true)
					@consoleTab("config", "Config", "/console/config", data.Active, true)
				</nav>
				if data.MissionControl != nil {
					@missionControlFragment(*data.MissionControl)
				}
				if data.Health != nil {
					@consoleHealthWallFragment(*data.Health)
				}
				if data.Kanban != nil {
					@consoleKanbanFragment(*data.Kanban)
					<div id="console-kanban-drawer"></div>
				}
				if data.IssueScan != nil {
					@consoleIssueScanSurface(*data.IssueScan)
					<div id="console-intake-drawer"></div>
				}
				if data.Config != nil {
					@consoleConfigFragment(*data.Config)
				}
			</main>
		</body>
		}
	</html>
}

templ consoleHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } — Mission control</title>
		<link rel="stylesheet" href={ assets.CSSURL() }/>
		<script src="/static/js/htmx.min.js"></script>
		<script src="/static/js/mission-control.js" defer></script>
	</head>
}

templ consoleTab(id, label, href, active string, enabled bool) {
	if !enabled {
		<span class="px-3 py-2 text-warm-muted cursor-not-allowed opacity-60" aria-disabled="true" title="coming soon">{ label }</span>
	} else if id == active {
		<a href={ templ.SafeURL(href) } aria-current="page" class="px-3 py-2 border-b-2 border-brand text-warm font-medium">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="px-3 py-2 text-warm-muted hover:text-warm transition-colors">{ label }</a>
	}
}

templ consoleFreshnessBadge(f ConsoleFreshness, generatedAt string) {
	switch f {
		case FreshnessCurrent:
			<span data-freshness="current" class="inline-flex items-center gap-1.5 text-xs text-emerald-300"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>live<span class="font-mono text-[11px] text-warm-muted">{ generatedAt }</span></span>
		case FreshnessStale:
			<span data-freshness="stale" class="inline-flex items-center gap-1.5 text-xs text-amber-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-400" aria-hidden="true"></span>stale · last update<span class="font-mono text-[11px] text-warm-muted">{ generatedAt }</span></span>
		case FreshnessPartial:
			<span data-freshness="partial" class="inline-flex items-center gap-1.5 text-xs text-amber-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-400" aria-hidden="true"></span>partial · some sources degraded</span>
		default:
			<span data-freshness="unavailable" class="inline-flex items-center gap-1.5 text-xs text-warm-muted"><span class="w-1.5 h-1.5 rounded-full border border-warm-muted" aria-hidden="true"></span>unavailable</span>
	}
}

templ consoleKanbanFragment(k ConsoleKanban) {
	<div id="console-kanban" hx-get={ "/console/kanban/fragment?lens=" + string(k.Lens) } hx-trigger="every 5s" hx-swap="outerHTML">
		@consoleKanban(k)
	</div>
}

templ consoleKanban(k ConsoleKanban) {
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			@consoleKanbanLensNav(k.Lens)
			@consoleFreshnessBadge(k.Freshness, k.GeneratedAt)
		</div>
		if k.Civilization {
			<div class="flex flex-wrap items-center justify-between gap-2 text-sm">
				<p class="text-warm-muted">Civilization work
					if k.Freshness != FreshnessUnavailable {
						if k.TotalCards == 1 {
							· 1 item
						} else {
							· { strconv.Itoa(k.TotalCards) } items
						}
					}
				</p>
				<a href="/console/workbench?view=team" class="text-brand hover:underline">Open Workbench team board →</a>
			</div>
			if k.Lens == LensAgent || k.Lens == LensRisk {
				<p class="text-xs text-warm-muted">Agent assignments and risk classes are not reported by this work feed. Cards show the execution host and time since the last update where available.</p>
			}
		}
		if k.Freshness == FreshnessUnavailable {
			<p class="text-sm text-warm-muted">unavailable — { noticeText(k.Notices) }</p>
		} else if k.TotalCards == 0 {
			<div class="border border-edge bg-surface rounded-lg p-6 space-y-2" data-state="empty">
				if k.Civilization {
					<p class="text-sm font-medium text-warm">No work yet.</p>
					<p class="text-sm text-warm-muted">Describe an outcome in Workbench to prepare a brief. Its progress will appear here.</p>
					<a href="/console/workbench" class="inline-block text-sm text-brand hover:underline">Create work →</a>
				} else {
					<p class="text-sm font-medium text-warm">No factory orders yet.</p>
					<p class="text-sm text-warm-muted">Work enters the factory at Intake: issues labeled <span class="font-mono text-[11px]">cc:pr-ready</span> are admitted by the issue scanner and become orders tracked here.</p>
					<a href="/console/intake" class="inline-block text-sm text-brand hover:underline">Go to Intake →</a>
				}
			</div>
		} else {
			<div class="flex gap-4 overflow-x-auto pb-2">
				for _, col := range k.Columns {
					<section class="w-80 max-w-full flex-shrink-0 space-y-2 break-words">
						<h2 class="flex items-center gap-2 text-xs uppercase tracking-wide text-warm-muted">{ col.Label } <span class="rounded-full bg-elevated px-2 py-0.5 text-[10px] font-mono text-warm-secondary">{ columnCount(col) }</span></h2>
						for _, card := range col.Cards {
							@consoleOrderCard(card)
						}
					</section>
				}
			</div>
		}
	</div>
}

templ consoleIssueScanSurface(s ConsoleIssueScan) {
	<div id="console-intake" hx-get="/console/intake/fragment" hx-trigger="every 10s" hx-swap="outerHTML">
		@consoleIssueScan(s)
	</div>
}

// consoleIssueScanFragment is the 10s poll response. It renders the board
// surface and an out-of-band reset that clears any open details drawer
// whenever the freshness is anything other than verified-current. The drawer
// can hold operator label-surgery commands (e.g. gh issue edit) that are only
// ever offered from a verified-current projection (see console.go's
// FreshnessCurrent-only unblock gate); once the poll reports the projection
// is no longer verified-current — stale, partial, unavailable, or any future
// freshness value — those commands are no longer valid, so the drawer must be
// cleared rather than left open with stale content. Only a poll that proves
// the projection is current is allowed to preserve an open drawer; every
// other outcome, known or not-yet-invented, clears it (allowlist, not
// denylist, over the freshness domain).
//
// This handles the downgrade case (current → not-current). It does NOT cover
// current-to-current drift: a later poll can still report FreshnessCurrent
// while the underlying labels/blockers changed (another operator edited
// labels between polls), which would leave a stale command copyable in an
// already-open drawer since the drawer lives outside this fragment's swap
// target (#console-intake-drawer is a sibling of #console-intake, not a
// child). That case is covered by the drawer's own self-refresh — see
// consoleIssueScanDrawer's doc comment.
templ consoleIssueScanFragment(s ConsoleIssueScan) {
	@consoleIssueScanSurface(s)
	if s.Freshness != FreshnessCurrent {
		<div id="console-intake-drawer" hx-swap-oob="innerHTML"></div>
	}
}

templ consoleIssueScan(s ConsoleIssueScan) {
	<section class="space-y-4" data-console-surface="intake">
		<div class="flex items-center justify-between gap-3">
			<div>
				<h2 class="text-lg font-medium text-warm">Intake — issue-scan lifecycle</h2>
				if s.Summary != "" && s.Freshness != FreshnessUnavailable {
					<p class="text-xs text-warm-muted mt-1">{ s.Summary }</p>
				}
			</div>
			@consoleFreshnessBadge(s.Freshness, s.GeneratedAt)
		</div>
		if s.RecentRuns.Available {
			@consoleRecentRunsRail(s.RecentRuns)
		}
		if s.SourceMarkers.Visible {
			@consoleSourceMarkers(s.SourceMarkers)
		}
		if s.Freshness == FreshnessUnavailable {
			<p class="text-sm text-warm-muted" data-state="unavailable">unavailable — { noticeText(s.Notices) }</p>
		} else if len(s.Board.Columns) == 0 {
			<div class="border border-edge bg-surface rounded-lg p-6 space-y-2" data-state="empty">
				<p class="text-sm font-medium text-warm">No issue-scan runs projected.</p>
				<p class="text-sm text-warm-muted">Runs appear after a scan cycle: one-shot <span class="font-mono text-[11px]">hive factory scan-issues</span>, or the scan daemon on its interval. Issues need the <span class="font-mono text-[11px]">cc:pr-ready</span> label to be admitted.</p>
			</div>
		} else {
			<div class="flex gap-4 overflow-x-auto pb-2">
				for _, col := range s.Board.Columns {
					<section class="min-w-[18rem] flex-shrink-0 space-y-2">
						<h3 class="flex items-center gap-2 text-xs uppercase tracking-wide text-warm-muted">{ col.Label } <span class="rounded-full bg-elevated px-2 py-0.5 text-[10px] font-mono text-warm-secondary">{ strconv.Itoa(len(col.Cards)) }</span></h3>
						for _, card := range col.Cards {
							@consoleIssueScanCard(card)
						}
					</section>
				}
			</div>
		}
	</section>
}

// consoleSourceMarkers renders read-only operator evidence from the
// issue_scan_source_markers projection section. It does not expose mutation
// controls and does not interpret derived GitHub marker comments as truth.
templ consoleSourceMarkers(markers ConsoleSourceMarkers) {
	<div class="space-y-2" data-console-source-markers>
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-[10px] uppercase tracking-widest text-warm-faint">source markers</h3>
			if markers.Available && markers.Truncated {
				<span class="text-[10px] text-amber-300">truncated</span>
			}
		</div>
		if !markers.Available {
			if markers.Summary != "" {
				<p class="text-xs text-warm-muted">{ markers.Summary }</p>
			}
			<p class="rounded border border-edge bg-surface/40 px-3 py-2 text-xs text-warm-muted">source-marker projection { opsCivilizationValue(markers.Status, "unavailable") }; no marker evidence rendered</p>
		} else if len(markers.Entries) == 0 {
			if markers.Summary != "" {
				<p class="text-xs text-warm-muted">{ markers.Summary }</p>
			}
			if markers.WithheldCount > 0 {
				<p class="rounded border border-edge bg-surface/40 px-3 py-2 text-xs text-warm-muted" data-state="source-markers-empty">No renderable source marker projections.</p>
			} else {
				<p class="rounded border border-edge bg-surface/40 px-3 py-2 text-xs text-warm-muted" data-state="source-markers-empty">No source marker projections are present.</p>
			}
		} else {
			if markers.Summary != "" {
				<p class="text-xs text-warm-muted">{ markers.Summary }</p>
			}
			<div class="grid gap-2 lg:grid-cols-2">
				for _, entry := range markers.Entries {
					@consoleSourceMarkerEntry(entry)
				}
			</div>
		}
		if markers.Available && markers.WithheldCount > 0 {
			<p class="rounded border border-amber-500/40 bg-surface/40 px-3 py-2 text-xs text-amber-300" data-state="source-markers-withheld">{ strconv.Itoa(markers.WithheldCount) } source marker projection(s) withheld: { opsCivilizationValue(markers.WithheldReason, "not renderable") }</p>
		}
	</div>
}

templ consoleSourceMarkerEntry(entry ConsoleSourceMarkerEntry) {
	<article class="rounded border border-edge bg-surface/40 p-3 space-y-2">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0 space-y-1">
				<div class="flex flex-wrap items-center gap-2">
					if entry.StyleKind == "amber" {
						<span class="rounded-full border border-amber-500/40 px-2 py-0.5 text-[10px] text-amber-300">{ opsCivilizationValue(entry.Transition, "not projected") }</span>
					} else if entry.StyleKind == "ready" {
						<span class="rounded-full border border-emerald-500/40 px-2 py-0.5 text-[10px] text-emerald-300">{ opsCivilizationValue(entry.Transition, "not projected") }</span>
					} else if entry.StyleKind == "muted" {
						<span class="rounded-full border border-edge px-2 py-0.5 text-[10px] text-warm-faint">{ opsCivilizationValue(entry.Transition, "not projected") }</span>
					} else {
						<span class="rounded-full border border-edge px-2 py-0.5 text-[10px] text-warm-muted">{ opsCivilizationValue(entry.Transition, "not projected") }</span>
					}
					if entry.StaleTarget {
						<span class="rounded-full border border-amber-500/40 px-2 py-0.5 text-[10px] text-amber-300">stale target</span>
					}
					if entry.SupersededBy != "" {
						<span class="rounded-full border border-edge px-2 py-0.5 text-[10px] text-warm-faint">superseded by { entry.SupersededBy }</span>
					}
				</div>
				<p class="text-sm text-warm font-medium break-words">
					if entry.IssueURL != "" {
						<a href={ templ.URL(entry.IssueURL) } class="text-brand hover:underline" target="_blank" rel="noreferrer">{ opsCivilizationValue(entry.IssueLabel, "target not projected") }</a>
					} else {
						{ opsCivilizationValue(entry.IssueLabel, "target not projected") }
					}
				</p>
			</div>
			if entry.Age != "" {
				<span class="text-[10px] font-mono text-warm-muted whitespace-nowrap">{ entry.Age }</span>
			}
		</div>
		<dl class="grid grid-cols-[8rem_1fr] gap-y-1 text-[11px]">
			<dt class="text-warm-muted">Run</dt>
			<dd class="break-all">{ opsCivilizationValue(entry.RunID, "not projected") }</dd>
			<dt class="text-warm-muted">Stage</dt>
			<dd class="break-all">
				{ opsCivilizationValue(entry.StageID, "not projected") }
				if entry.StageNumber > 0 {
					<span class="text-warm-faint">({ strconv.Itoa(entry.StageNumber) })</span>
				}
			</dd>
			<dt class="text-warm-muted">Gate</dt>
			<dd class="break-all">{ opsCivilizationValue(entry.Gate, "not projected") }</dd>
			<dt class="text-warm-muted">Actor</dt>
			<dd class="break-all">{ opsCivilizationValue(entry.ActorRole, "role not projected") } / { opsCivilizationValue(entry.ActorID, "actor not projected") }</dd>
			<dt class="text-warm-muted">Occurred</dt>
			<dd class="break-all">{ opsCivilizationValue(entry.OccurredAt, "not projected") }</dd>
			<dt class="text-warm-muted">Idempotency</dt>
			<dd class="break-all">{ opsCivilizationValue(entry.IdempotencyKey, "not projected") }</dd>
			<dt class="text-warm-muted">Authority</dt>
			<dd class="break-words">{ opsCivilizationValue(entry.AuthorityBoundary, "not projected") }</dd>
		</dl>
		<div class="grid gap-2 md:grid-cols-2 text-[10px]">
			<div class="space-y-1">
				<p class="uppercase tracking-widest text-warm-faint">canonical Work refs</p>
				<p class="text-warm-muted break-all">{ opsCivilizationJoinSummary(entry.WorkRefs, "none projected", 8) }</p>
			</div>
			<div class="space-y-1">
				<p class="uppercase tracking-widest text-warm-faint">EventGraph projection refs</p>
				<p class="text-warm-muted break-all">{ opsCivilizationJoinSummary(entry.EventGraphRefs, "none projected", 8) }</p>
			</div>
		</div>
		<div class="grid gap-2 md:grid-cols-2 text-[10px]">
			<div class="space-y-1">
				<p class="uppercase tracking-widest text-warm-faint">evidence refs</p>
				<p class="text-warm-muted break-all">{ opsCivilizationJoinSummary(entry.EvidenceRefs, "none projected", 8) }</p>
			</div>
			<div class="space-y-1">
				<p class="uppercase tracking-widest text-warm-faint">authority exclusions</p>
				<p class="text-warm-muted break-all">{ opsCivilizationJoinSummary(entry.AuthorityExclusions, "none projected", 6) }</p>
			</div>
		</div>
		<p class="text-[10px] text-warm-faint break-words">
			projection: { opsCivilizationValue(entry.ProjectionKind, "not projected") };
			canonical source: { opsCivilizationValue(entry.CanonicalSource, "not projected") };
			projection only: { opsCivilizationBoolValue(entry.ProjectionOnly) }
		</p>
		<p class="text-[10px] text-warm-faint break-words">
			work ref: { opsCivilizationValue(entry.WorkProjectionKind, "not projected") };
			work canonical source: { opsCivilizationValue(entry.WorkCanonicalSource, "not projected") };
			work projection only: { opsCivilizationBoolValue(entry.WorkProjectionOnly) }
		</p>
		if entry.HasGitHubMarker {
			<div class="border-t border-edge pt-2 space-y-1 text-[10px]" data-derived-github-marker>
				<p class="uppercase tracking-widest text-warm-faint">derived GitHub marker (projection only)</p>
				<p class="text-warm-muted break-all">
					{ opsCivilizationValue(entry.GitHubMarkerSystem, "system not projected") } /
					{ entry.GitHubMarkerIssueLabel };
					derived output: { opsCivilizationBoolValue(entry.GitHubDerivedOutput) };
					projection sink: { opsCivilizationBoolValue(entry.GitHubProjectionSink) }
				</p>
				if entry.GitHubMarkerCommentURL != "" {
					<a href={ templ.URL(entry.GitHubMarkerCommentURL) } class="text-brand hover:underline break-all" target="_blank" rel="noreferrer">comment { opsCivilizationValue(entry.GitHubMarkerCommentID, "id not projected") }</a>
				} else {
					<p class="text-warm-muted break-all">comment { opsCivilizationValue(entry.GitHubMarkerCommentID, "not projected") }</p>
				}
				<p class="text-warm-muted break-all">labels: { opsCivilizationJoin(entry.GitHubMarkerLabels, "none projected") }</p>
			</div>
		}
	</article>
}

// consoleRecentRunsRail renders the recent-intakes rail: a horizontal-scroll
// strip of compact chips above the board. Rendered only when
// s.RecentRuns.Available (checked by the caller, consoleIssueScan) — this
// templ itself does not re-check Available so it stays a pure render of
// whatever entries it's given; the fail-closed gate lives in
// buildConsoleRecentRuns (graph/console.go), not here.
templ consoleRecentRunsRail(rail ConsoleRecentRuns) {
	<div class="space-y-2" data-console-rail>
		<h3 class="text-[10px] uppercase tracking-widest text-warm-faint">recent intakes</h3>
		<div class="flex gap-2 overflow-x-auto pb-1">
			for _, entry := range rail.Entries {
				@consoleRecentRunChip(entry)
			}
			if rail.Truncated {
				<span class="text-[10px] text-warm-faint whitespace-nowrap self-center">… truncated</span>
			}
		</div>
	</div>
}

// consoleRecentRunChip renders one rail entry. Linked entries (their
// (RunID, StageID) exists on the rendered board — see buildConsoleRecentRuns)
// are an <a> wired to the same drawer target/swap mechanics as a board card;
// unlinked entries are a plain <span> with identical visual styling and no
// hx-get, so the rail never fabricates a drawer target the board itself
// doesn't expose.
templ consoleRecentRunChip(entry ConsoleRecentRunEntry) {
	if entry.Linked {
		<a
			href="#"
			class="flex-shrink-0 flex flex-col gap-0.5 rounded border border-edge bg-surface/40 px-2 py-1 hover:border-brand transition-colors"
			hx-get={ entry.DrawerURL }
			hx-target="#console-intake-drawer"
			hx-swap="innerHTML"
		>
			@consoleRecentRunChipContent(entry)
		</a>
	} else {
		<span class="flex-shrink-0 flex flex-col gap-0.5 rounded border border-edge bg-surface/40 px-2 py-1">
			@consoleRecentRunChipContent(entry)
		</span>
	}
}

templ consoleRecentRunChipContent(entry ConsoleRecentRunEntry) {
	<span class="text-xs text-warm whitespace-nowrap">{ entry.IssueLabel }</span>
	if entry.StyleKind == "amber" {
		<span class="text-[10px] text-amber-300 whitespace-nowrap">{ entry.State }</span>
	} else {
		<span class="text-[10px] text-warm-muted whitespace-nowrap">{ entry.State }</span>
	}
	if entry.Age != "" {
		<span class="text-[10px] font-mono text-warm-muted whitespace-nowrap">{ entry.Age }</span>
	}
}

templ consoleIssueScanCard(card OpsCivilizationIssueScanKanbanCard) {
	// hx-get is an HTML attribute (templ's attribute-escaping via ResolveAttributeValue->EscapeString guards HTML injection; SafeURL is for href sinks). consoleIssueScanCardURL additionally query-escapes run/stage so ids with query metacharacters round-trip exactly to the handler's r.URL.Query().Get.
	<button
		type="button"
		class="w-full text-left rounded border border-edge bg-surface/40 p-3 space-y-1 hover:border-brand transition-colors"
		hx-get={ consoleIssueScanCardURL(card) }
		hx-target="#console-intake-drawer"
		hx-swap="innerHTML"
	>
		<div class="flex items-center justify-between gap-2">
			<span class="text-sm text-warm font-medium break-words">{ consoleIssueScanCardIssue(card) }</span>
			if card.StageNumber > 0 {
				<span class="text-[10px] text-warm-muted font-mono whitespace-nowrap">{ fmt.Sprintf("%d/%d", card.StageNumber, card.StageCount) }</span>
			}
		</div>
		if consoleIssueScanCardTitle(card) != "" {
			<p class="text-xs text-warm-muted break-words">{ consoleIssueScanCardTitle(card) }</p>
		}
		<div class="flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-warm-muted">
			<span>stage: { opsCivilizationValue(card.StageID, "—") }</span>
			<span>agents: { consoleIssueScanCardAgents(card) }</span>
		</div>
		if len(card.Blockers) > 0 {
			<p class="text-xs text-amber-300 break-words">blocked: { consoleIssueScanCardBlocker(card) }</p>
		}
		if card.UnblockAvailable {
			<p class="text-[10px] text-brand">unblock available — open for the exact commands</p>
		}
		if consoleIssueScanCardReady(card) {
			<p class="text-xs text-emerald-300">ready for human — not merged</p>
		}
		if card.ProjectionSource != "" {
			// Provenance: distinguishes runtime cards ("typed issue-scan projection")
			// from issue-intake fallback cards ("scanner issue-intake fallback; not
			// runtime execution or agent-touch evidence") so a ready fallback card
			// cannot masquerade as a runtime lifecycle card.
			<p class="text-[10px] text-warm-faint break-words">source: { card.ProjectionSource }</p>
		}
	</button>
}

// consoleIssueScanDrawer renders the run-details drawer and self-revalidates
// every 10s (hx-get/hx-trigger/hx-swap on the <aside> root) so a command it
// renders cannot go stale while the drawer stays open. Two mechanisms cover
// the two ways the projection can move after the drawer opens:
//   - Downgrade (current → not-current): consoleIssueScanFragment's OOB reset
//     clears #console-intake-drawer on the board's own 10s poll.
//   - Current-to-current drift (labels/blockers change but freshness stays
//     FreshnessCurrent — e.g. another operator removes cc:needs-human-scope
//     or adds cc:pr-deferred between polls): the OOB reset above never fires,
//     since freshness didn't downgrade. This self-refresh closes that gap:
//     every 10s the drawer re-requests its own card URL, which re-runs
//     handleConsoleIntakeCard and re-derives the plan from the freshest
//     projection through the same fail-closed gate
//     (consoleIssueScanUnblockPlan). A command that's no longer corroborated
//     by current labels disappears within one poll cycle; a run that
//     disappears entirely renders the honest not-found drawer. RunID/StageID
//     are populated on both the found and not-found paths (see
//     handleConsoleIntakeCard), so consoleIssueScanCardURL is always valid
//     here. Closing the drawer (below) removes this element from the DOM,
//     which stops the polling — htmx does not poll a target no longer
//     present in the document.
templ consoleIssueScanDrawer(card OpsCivilizationIssueScanKanbanCard, found bool, plan consoleUnblockPlan, planOK bool) {
	<aside
		class="rounded border border-edge bg-surface/60 p-4 space-y-3"
		role="dialog"
		aria-label="Issue-scan run details"
		hx-get={ consoleIssueScanCardURL(card) }
		hx-trigger="every 10s"
		hx-swap="outerHTML"
	>
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-sm font-medium text-warm">Run details</h3>
			<button type="button" class="text-xs text-warm-muted hover:text-warm" onclick="document.getElementById('console-intake-drawer').innerHTML='';return false;">close</button>
		</div>
		if !found {
			<p class="text-sm text-warm-muted">Run { opsCivilizationValue(card.RunID, "—") } stage { opsCivilizationValue(card.StageID, "—") } is unavailable (not found).</p>
		} else {
			<dl class="grid grid-cols-[9rem,1fr] gap-y-1 text-xs">
				<dt class="text-warm-muted">Issue</dt>
				<dd class="text-warm break-words">
					if consoleIssueScanCardIssueURL(card) != "" {
						// templ.URL sanitizes the projection-supplied URL (javascript:/data: → about:invalid); do NOT use SafeURL on untrusted input.
						<a href={ templ.URL(consoleIssueScanCardIssueURL(card)) } class="text-brand hover:underline" target="_blank" rel="noreferrer">{ consoleIssueScanCardIssue(card) }</a>
					} else {
						{ consoleIssueScanCardIssue(card) }
					}
				</dd>
				<dt class="text-warm-muted">Stage</dt>
				<dd class="break-all">{ opsCivilizationValue(card.StageID, "—") }</dd>
				<dt class="text-warm-muted">State</dt>
				<dd>{ opsCivilizationValue(card.CurrentState, "—") }</dd>
				<dt class="text-warm-muted">Assigned</dt>
				<dd class="break-all">{ opsCivilizationJoin(card.AssignedAgentIDs, "none projected") }</dd>
				<dt class="text-warm-muted">Touching</dt>
				<dd class="break-all">{ opsCivilizationJoin(card.TouchingAgentIDs, "none projected") }</dd>
				<dt class="text-warm-muted">Authority</dt>
				<dd class="break-words">{ opsCivilizationValue(card.AuthorityBoundary, "not projected") }</dd>
				<dt class="text-warm-muted">Run</dt>
				<dd class="break-all">{ opsCivilizationValue(card.RunID, "—") }</dd>
				<dt class="text-warm-muted">Canonical task</dt>
				<dd class="break-all">{ opsCivilizationValue(card.CanonicalTaskID, opsCivilizationValue(card.TaskID, "not projected")) }</dd>
			</dl>
			if chips := consoleIssueScanRefChips(card); len(chips) > 0 {
				<div class="flex flex-wrap gap-1 pt-1">
					for _, chip := range chips {
						switch chip.Kind {
							case "deny":
								<span class="inline-flex items-center rounded-full border border-amber-500/40 px-2 py-0.5 text-[10px] text-amber-300">{ chip.Label }</span>
							case "ready":
								<span class="inline-flex items-center rounded-full border border-emerald-500/40 px-2 py-0.5 text-[10px] text-emerald-300">{ chip.Label }</span>
							case "cc":
								<span class="inline-flex items-center rounded-full border border-edge px-2 py-0.5 text-[10px] text-warm-muted">{ chip.Label }</span>
							default:
								<span class="text-[10px] text-warm-muted">{ chip.Label }</span>
						}
					}
				</div>
			}
			if planOK {
				<div class="border-t border-edge pt-3 space-y-2" data-console-unblock>
					<p class="text-[10px] text-warm-faint uppercase tracking-widest">unblock</p>
					if plan.ScopeCommand != "" {
						<p class="text-xs text-warm-secondary break-words">Relabel the target issue to admit it. Hive reads labels only — it never edits them; this action is yours:</p>
						<pre class="bg-elevated border border-edge rounded p-2 overflow-x-auto"><code class="text-[11px] font-mono text-warm-secondary select-all">{ plan.ScopeCommand }</code></pre>
					}
					if plan.ScopeCommand != "" && plan.ProtectedCommand != "" {
						<p class="text-xs text-warm-muted break-words">The scope command alone does not admit the issue — the protected-action boundary below must be separately authorized.</p>
					}
					if plan.ProtectedCommand != "" {
						<p class="text-xs text-amber-300 break-words">This second command clears a protected-action boundary — run it only if you authorize the protected action:</p>
						<pre class="bg-elevated border border-amber-500/40 rounded p-2 overflow-x-auto"><code class="text-[11px] font-mono text-warm-secondary select-all">{ plan.ProtectedCommand }</code></pre>
					}
					<p class="text-xs text-warm-secondary break-words"><span class="text-warm font-medium">A parked run is terminal.</span> Fixing labels does not resume this run — the parked event is final and idempotent. After relabeling, a fresh scan cycle is needed: the command below scans this repo&apos;s whole PR-ready pool and the scanner selects one candidate, which is not guaranteed to be this issue (add <span class="font-mono">--dispatch</span> to also launch the queued run as a factory order); or wait for the scan daemon&apos;s next interval.</p>
					<pre class="bg-elevated border border-edge rounded p-2 overflow-x-auto"><code class="text-[11px] font-mono text-warm-secondary select-all">{ plan.RescanCommand }</code></pre>
					<p class="text-[10px] text-warm-muted">Replace YOUR_NAME with the requesting human. Daemon alternative: <span class="font-mono">hive factory daemon --issue-scan-interval 15m</span></p>
				</div>
			}
			if len(card.Blockers) > 0 {
				<div class="border-t border-edge pt-3 space-y-2">
					<p class="text-[10px] text-warm-faint uppercase tracking-widest">blockers</p>
					for _, b := range card.Blockers {
						<div>
							<p class="text-xs text-warm break-words">{ opsCivilizationEvidenceStatusValue(b.BlockerType, "blocker") }</p>
							<p class="text-[10px] text-warm-muted break-words">{ opsCivilizationValue(b.RequiredAction, "action not projected") }</p>
						</div>
					}
				</div>
			}
			if card.HasLineage {
				<div class="border-t border-edge pt-3">
					<p class="text-[10px] text-warm-faint uppercase tracking-widest">lineage</p>
					<p class="text-[10px] text-warm-muted break-all mt-1">primary { opsCivilizationValue(card.Lineage.PrimaryTaskID, "not projected") }</p>
					<p class="text-[10px] text-warm-faint break-all mt-1">duplicates { opsCivilizationJoin(card.Lineage.DuplicateTaskIDs, "none") }</p>
				</div>
			}
			if len(card.EvidenceRefs) > 0 {
				<div class="border-t border-edge pt-3">
					<p class="text-[10px] text-warm-faint uppercase tracking-widest">evidence</p>
					<p class="text-[10px] text-warm-muted break-all mt-1">{ opsCivilizationJoin(card.EvidenceRefs, "none projected") }</p>
				</div>
			}
		}
	</aside>
}

templ consoleKanbanLensNav(active ConsoleKanbanLens) {
	<div class="inline-flex rounded-md border border-edge overflow-hidden text-xs" role="group" aria-label="Kanban lens">
		@consoleLensLink("risk", "Risk + aging", active)
		@consoleLensLink("status", "Status", active)
		@consoleLensLink("agent", "Agent", active)
		@consoleLensLink("source", "Source", active)
	</div>
}

templ consoleLensLink(lens, label string, active ConsoleKanbanLens) {
	if ConsoleKanbanLens(lens) == active {
		<a href={ templ.SafeURL("/console/kanban?lens=" + lens) } aria-current="true" class="px-2.5 py-1 bg-elevated text-warm border-l border-edge first:border-l-0">{ label }</a>
	} else {
		<a href={ templ.SafeURL("/console/kanban?lens=" + lens) } class="px-2.5 py-1 text-warm-muted hover:text-warm hover:bg-elevated/50 transition-colors border-l border-edge first:border-l-0">{ label }</a>
	}
}

templ consoleOrderCard(card ConsoleOrderCard) {
	// hx-get uses a plain string (not templ.SafeURL): hx-* is an HTML attribute, so templ's attribute-escaping (ResolveAttributeValue->EscapeString) is the right protection; SafeURL is for href URL sinks.
	<button
		type="button"
		class="w-full text-left rounded border border-edge bg-surface/40 p-3 space-y-2 hover:border-brand transition-colors"
		data-work-id={ card.ID }
		hx-get={ card.DrawerURL() }
		hx-target="#console-kanban-drawer"
		hx-swap="innerHTML"
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<span class="text-sm text-warm font-medium">{ cardTitle(card) }</span>
			<span class="text-[10px] text-warm-muted font-mono break-all">{ cardTag(card) }</span>
		</div>
		<div class="flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-warm-muted">
			<span>by { orFallback(card.Submitter, "unknown") }</span>
			<span>{ orFallback(card.Status, "unknown") }</span>
			if !card.Civilization {
				<span>{ orFallback(card.Agent, "unassigned") }</span>
			}
			if card.Risk != "" {
				<span>risk: { card.Risk }</span>
			}
			if card.AgeLabel != "" {
				<span>{ card.AgeLabel }</span>
			}
		</div>
		if card.Civilization {
			<p class="text-xs text-warm-muted">{ card.Repository }</p>
			<p class="text-xs text-warm-secondary">Host: { card.Provider }</p>
			if card.HumanStep != "" {
				<p class="text-xs text-amber-300">{ card.HumanStep } · Responsible: { card.HumanOwner }</p>
			}
			if card.Blocker != "" {
				<p class="text-xs text-amber-300">{ card.Blocker }</p>
			}
			if card.UpdatedLabel != "" {
				<p class="text-xs text-warm-muted">Updated { card.UpdatedLabel } ago</p>
			}
		}
	</button>
}

templ consoleOrderDrawer(card ConsoleOrderCard, found bool) {
	<aside class="rounded border border-edge bg-surface/60 p-4 space-y-3 break-words" role="dialog" aria-label="Order details" hx-get={ card.DrawerURL() } hx-trigger="every 5s" hx-swap="outerHTML">
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-sm font-medium text-warm">Order details</h3>
			<button type="button" class="text-xs text-warm-muted hover:text-warm" onclick="document.getElementById('console-kanban-drawer').innerHTML='';return false;">close</button>
		</div>
		if !found {
			<p class="text-sm text-warm-muted">Order { card.ID } is unavailable (not found).</p>
		} else if card.Civilization {
			<dl class="grid grid-cols-[8rem_minmax(0,1fr)] gap-x-3 gap-y-2 text-xs [&_dd]:min-w-0 [&_dd]:break-words">
				<dt class="text-warm-muted">Title</dt><dd>{ cardTitle(card) }</dd>
				<dt class="text-warm-muted">Work</dt><dd class="break-all">{ card.ID }</dd>
				<dt class="text-warm-muted">Repository</dt><dd>{ card.Repository }</dd>
				<dt class="text-warm-muted">Requester</dt><dd>{ card.Submitter }</dd>
				<dt class="text-warm-muted">Status</dt><dd>{ civilizationStateLabel(card.Status) }</dd>
				<dt class="text-warm-muted">Execution host</dt><dd>{ card.Provider }</dd>
				<dt class="text-warm-muted">Agent</dt><dd>Not linked by this work feed</dd>
				<dt class="text-warm-muted">Responsible person</dt><dd>{ card.HumanOwner }</dd>
				<dt class="text-warm-muted">Human step</dt><dd>{ orFallback(card.HumanStep, "None pending") }</dd>
				<dt class="text-warm-muted">Blocker</dt><dd>{ orFallback(card.Blocker, "None reported") }</dd>
				<dt class="text-warm-muted">Last updated</dt><dd>{ orFallback(card.UpdatedAt, "Not reported") }</dd>
			</dl>
			<a href={ templ.URL(civilizationWorkInspectURL(card.ID, card.Status)) } class="inline-block text-sm text-brand hover:underline">Open work and actions →</a>
		} else {
			<dl class="grid grid-cols-[8rem,1fr] gap-y-1 text-xs">
				<dt class="text-warm-muted">Title</dt>
				<dd class="text-warm">{ cardTitle(card) }</dd>
				<dt class="text-warm-muted">Order</dt>
				<dd class="font-mono text-warm">{ cardTag(card) }</dd>
				<dt class="text-warm-muted">Submitter</dt>
				<dd>{ orFallback(card.Submitter, "unknown") }</dd>
				<dt class="text-warm-muted">Status</dt>
				<dd>{ orFallback(card.Status, "unknown") }</dd>
				<dt class="text-warm-muted">Agent</dt>
				<dd>{ orFallback(card.Agent, "unassigned") }</dd>
				<dt class="text-warm-muted">Risk</dt>
				<dd>{ orFallback(card.Risk, "unclassified") }</dd>
				<dt class="text-warm-muted">Cell</dt>
				<dd>{ orFallback(card.Cell, "—") }</dd>
				<dt class="text-warm-muted">Age</dt>
				<dd>{ orFallback(card.AgeLabel, "—") }</dd>
				<dt class="text-warm-muted">Effort to date</dt>
				<dd class="text-warm-muted italic">unavailable — not yet in any projection</dd>
				<dt class="text-warm-muted">Predicted effort</dt>
				<dd class="text-warm-muted italic">unavailable — not yet in any projection</dd>
				<dt class="text-warm-muted">Linked PR</dt>
				<dd class="text-warm-muted italic">unavailable — not yet in any projection</dd>
			</dl>
		}
	</aside>
}

templ consoleHealthWallFragment(w ConsoleHealthWall) {
	<div id="console-health" hx-get="/console/health/fragment" hx-trigger="every 5s" hx-swap="outerHTML">
		@consoleHealthWall(w)
	</div>
}

templ consoleHealthWall(w ConsoleHealthWall) {
	<section class="space-y-4" data-console-surface="health">
		<div class="flex items-center justify-between">
			<h2 class="text-lg font-medium text-warm">Health wall</h2>
			@consoleFreshnessBadge(w.Freshness, w.GeneratedAt)
		</div>
		if w.Freshness == FreshnessUnavailable {
			<div class="border border-edge bg-surface rounded-lg p-4 text-sm text-warm-muted" data-state="unavailable">
				<p class="font-medium text-warm">Live status unavailable</p>
				for _, n := range w.Notices {
					<p class="mt-1">{ n }</p>
				}
			</div>
		} else {
			<div class="grid grid-cols-2 md:grid-cols-3 gap-3">
				<div class="border border-edge bg-surface rounded-lg p-4">
					<p class="text-xs text-warm-muted">Active agents</p>
					<p class="text-2xl text-warm">{ strconv.Itoa(w.ActiveAgents) }</p>
				</div>
				<div class="border border-edge bg-surface rounded-lg p-4">
					<p class="text-xs text-warm-muted">Needs you</p>
					<p class="text-2xl text-warm">{ strconv.Itoa(w.PendingApprovals) }</p>
					<p class="text-xs text-warm-muted">pending approvals</p>
				</div>
			</div>
			<div class="border border-edge bg-surface rounded-lg overflow-hidden">
				<div class="px-4 py-2 border-b border-edge text-sm font-medium text-warm">Agents</div>
				if len(w.Agents) == 0 {
					<div class="px-4 py-3 text-sm text-warm-muted">No active agents. Agents report here while a civilization run is in flight; between runs an empty roster is the honest state.</div>
				} else {
					for _, a := range w.Agents {
						<div class="flex items-center gap-3 px-4 py-2 border-b border-edge last:border-0">
							<span class="text-sm font-medium text-warm w-28 truncate">{ a.Name }</span>
							<span class="text-xs text-warm-muted">{ a.Role }</span>
							<span class="text-xs text-warm-muted ml-auto">{ a.Model }</span>
						</div>
					}
				}
			</div>
			if len(w.Notices) > 0 {
				<div class="border border-amber-500/40 bg-surface rounded-lg p-3 text-xs text-amber-300">
					for _, n := range w.Notices {
						<p>{ n }</p>
					}
				</div>
			}
		}
	</section>
}

templ consoleConfigFragment(c ConsoleConfig) {
	<div id="console-config" hx-get="/console/config/fragment" hx-trigger="every 10s" hx-swap="outerHTML">
		@consoleConfig(c)
	</div>
}

// consoleConfig renders the read-only model-routing surface: catalog,
// role→model assignments, and default-vs-override provenance. It carries NO
// write affordances — no form, no input, no button. The governed write
// (POST /ops/hive/model-policy) intentionally stays on the /ops surface.
templ consoleConfig(c ConsoleConfig) {
	<section class="space-y-4" data-console-surface="config">
		<div class="flex items-center justify-between gap-3">
			<div>
				<h2 class="text-lg font-medium text-warm">Config — model routing</h2>
				<p class="text-xs text-warm-muted mt-1">read-only projection · policy editing is governed and lives on the /ops surface</p>
			</div>
			@consoleFreshnessBadge(c.Freshness, c.GeneratedAt)
		</div>
		if c.Freshness == FreshnessUnavailable {
			<p class="text-sm text-warm-muted" data-state="unavailable">unavailable — { noticeText(c.Notices) }</p>
		} else {
			if len(c.Notices) > 0 {
				<div class="border border-amber-500/40 bg-surface rounded-lg p-3 text-xs text-amber-300">
					for _, n := range c.Notices {
						<p>{ n }</p>
					}
				</div>
			}
			<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
				<div class="border border-edge bg-surface rounded-lg p-4">
					<p class="text-xs text-warm-muted">Catalog models</p>
					<p class="text-2xl text-warm">{ strconv.Itoa(len(c.Selection.Models)) }</p>
				</div>
				<div class="border border-edge bg-surface rounded-lg p-4">
					<p class="text-xs text-warm-muted">Role assignments</p>
					<p class="text-2xl text-warm">{ strconv.Itoa(len(c.Selection.Assignments)) }</p>
				</div>
				<div class="border border-edge bg-surface rounded-lg p-4">
					<p class="text-xs text-warm-muted">Global mode</p>
					<p class="text-sm text-warm mt-2">{ consoleConfigGlobalMode(c.Selection) }</p>
				</div>
				<div class="border border-edge bg-surface rounded-lg p-4">
					<p class="text-xs text-warm-muted">Catalog source</p>
					<p class="text-xs text-warm mt-2 break-all">{ orFallback(c.Selection.CatalogSource, "not projected") }</p>
				</div>
			</div>
			<div class="border border-edge bg-surface rounded-lg overflow-hidden">
				<div class="px-4 py-2 border-b border-edge text-sm font-medium text-warm">Role → model routing</div>
				if len(c.Selection.Assignments) == 0 {
					<div class="px-4 py-3 text-sm text-warm-muted">No role assignments projected. Role routing appears once the hive projects its model-selection policy.</div>
				} else {
					for _, item := range c.Selection.Assignments {
						<div class="px-4 py-2 border-b border-edge last:border-0">
							<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
								<span class="text-sm font-medium text-warm w-32 truncate">{ orFallback(item.Role, "role not projected") }</span>
								<span class="text-xs text-warm font-mono break-all">{ consoleConfigAssignmentModel(item) }</span>
								<span class="text-xs text-warm-muted">{ consoleConfigAssignmentProvider(item) }</span>
								<span class="text-xs text-warm-muted ml-auto">{ consoleConfigAssignmentMode(c.Selection, item) }</span>
							</div>
							if item.Error != "" {
								<p class="text-xs text-amber-300 mt-1 break-words">{ item.Error }</p>
							}
						</div>
					}
				}
			</div>
			<div class="border border-edge bg-surface rounded-lg overflow-hidden">
				<div class="px-4 py-2 border-b border-edge text-sm font-medium text-warm">Model catalog</div>
				<div class="px-4 py-3 border-b border-edge space-y-3">
					<p class="text-xs text-warm-muted">Known model choices grouped by credential path. “Catalog checked” means the model metadata was reviewed on that date; it does not prove that this deployment can execute the model.</p>
					<div class="grid gap-2 md:grid-cols-3" aria-label="Routing tier definitions">
						<div class="rounded-md border border-edge bg-void/30 px-3 py-2">
							<p class="text-xs font-medium text-warm">Judgment</p>
							<p class="mt-1 text-[11px] text-warm-muted">Deep reasoning for ambiguous, high-impact planning and review.</p>
						</div>
						<div class="rounded-md border border-edge bg-void/30 px-3 py-2">
							<p class="text-xs font-medium text-warm">Execution</p>
							<p class="mt-1 text-[11px] text-warm-muted">Balanced work for implementation and tool use.</p>
						</div>
						<div class="rounded-md border border-edge bg-void/30 px-3 py-2">
							<p class="text-xs font-medium text-warm">Volume</p>
							<p class="mt-1 text-[11px] text-warm-muted">Fast, economical handling of routine, high-throughput work.</p>
						</div>
					</div>
				</div>
				if len(c.Selection.Models) == 0 {
					<div class="px-4 py-3 text-sm text-warm-muted">No catalog models projected. The catalog is hive-owned (<span class="font-mono text-[11px]">HIVE_OPS_CATALOG</span>) and hot-reloaded.</div>
				} else {
					@consoleConfigModelGroup("Subscription access", "Uses an authenticated Claude Code or Codex CLI session. No provider API key is required.", "subscription", consoleConfigModelsByAuth(c.Selection.Models, "subscription"))
					@consoleConfigModelGroup("API key access", "Requires a separately configured provider API key. A CLI subscription does not authorize these entries.", "api-key", consoleConfigModelsByAuth(c.Selection.Models, "api-key"))
					@consoleConfigModelGroup("Other access", "Uses a local or separately defined credential path.", "other", consoleConfigModelsWithOtherAuth(c.Selection.Models))
				}
			</div>
			<p class="text-xs text-warm-muted">Model policy is hive-owned. This console renders the routing projection only; it never persists or forwards changes.</p>
		}
	</section>
}

templ consoleConfigModelGroup(title, description, access string, models []OpsHiveModelCatalogEntry) {
	if len(models) > 0 {
		<section data-model-access={ access } class="border-b border-edge last:border-0">
			<div class="flex flex-col gap-1 border-b border-edge bg-void/20 px-4 py-3 md:flex-row md:items-start md:justify-between md:gap-4">
				<div>
					<h3 class="text-sm font-medium text-warm">{ title }</h3>
					<p class="mt-1 text-xs text-warm-muted">{ description }</p>
				</div>
				<span class="shrink-0 text-xs text-warm-faint">{ strconv.Itoa(len(models)) } models</span>
			</div>
			for _, model := range models {
				@consoleConfigModelRow(model)
			}
		</section>
	}
}

templ consoleConfigModelRow(model OpsHiveModelCatalogEntry) {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-edge px-4 py-2 last:border-0">
		<span class="text-sm text-warm font-mono break-all">{ orFallback(model.ID, "id not projected") }</span>
		if model.Metadata["subscription_verified_at"] != "" {
			<span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 text-[10px] text-emerald-300">Subscription verified { model.Metadata["subscription_verified_at"] }</span>
		} else if model.Metadata["subscription_unavailable_at"] != "" {
			<span class="rounded-full border border-rose-400/30 bg-rose-400/10 px-2 py-0.5 text-[10px] text-rose-300">Unavailable via subscription { model.Metadata["subscription_unavailable_at"] }</span>
		}
		if model.Metadata["verified_at"] != "" {
			<span class="text-xs text-emerald-300">Catalog checked { model.Metadata["verified_at"] }</span>
		}
		<span class="text-xs text-warm-muted">{ orFallback(model.Provider, "provider not projected") }</span>
		<span class="text-xs text-warm-muted">{ orFallback(model.Tier, "tier not projected") }</span>
		if model.Deprecated {
			<span class="text-xs text-amber-300 ml-auto">deprecated</span>
		}
	</div>
}
